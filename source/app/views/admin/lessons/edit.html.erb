<h1 class="text-2xl font-extrabold">Edit lesson</h1>
<%= form_with model: [:admin, @lesson], class: "mt-6 max-w-2xl space-y-5" do |f| %>
  <% if @lesson.errors.any? %><div class="flash-alert !mx-0"><%= @lesson.errors.full_messages.join(", ") %></div><% end %>
  <div class="grid grid-cols-3 gap-4">
    <div><%= f.label :position, class: "label" %><%= f.number_field :position, class: "field" %></div>
    <div><%= f.label :kind, class: "label" %><%= f.select :kind, Lesson::KINDS, {}, class: "field" %></div>
    <div><%= f.label :published, class: "label" %><label class="flex items-center gap-2 mt-3"><%= f.check_box :published %> Visible to people</label></div>
  </div>
  <div><%= f.label :title, class: "label" %><%= f.text_field :title, class: "field" %></div>
  <div><%= f.label :description, "One-line description (shown on My Progress)", class: "label" %><%= f.text_field :description, class: "field" %></div>
  <div class="grid grid-cols-2 gap-4">
    <div><%= f.label :vimeo_id, "Vimeo video ID (numbers only)", class: "label" %><%= f.text_field :vimeo_id, class: "field", placeholder: "e.g. 123456789" %></div>
    <div><%= f.label :vimeo_hash, "Unlisted hash (optional, the ?h= value)", class: "label" %><%= f.text_field :vimeo_hash, class: "field" %></div>
  </div>
  <div><%= f.label :thumbnail, "Thumbnail (JPG/PNG, 16:9)", class: "label" %><%= f.file_field :thumbnail, class: "field", accept: "image/*" %>
    <% if @lesson.thumbnail.attached? %><p class="text-xs text-mute mt-1">Current: <%= @lesson.thumbnail.filename %></p><% end %></div>
  <div><%= f.label :body, "Text under the video / text lesson body", class: "label" %><%= f.text_area :body, rows: 12, class: "field font-mono text-sm" %>
    <p class="text-xs text-mute mt-1">Formatting: blank line = new paragraph · <code>## Heading</code> · <code>- bullet</code> · <code>**bold**</code> · <code>&gt; quote</code></p></div>
  <div><%= f.label :speaker_notes, "Speaker notes / script outline (internal, never shown)", class: "label" %><%= f.text_area :speaker_notes, rows: 8, class: "field font-mono text-sm" %></div>
  <div class="flex gap-3"><%= f.submit "Save", class: "btn-go" %><%= link_to "Cancel", admin_lessons_path, class: "btn-ghost" %></div>
<% end %>
