<h1 class="text-2xl font-extrabold"><%= @user.full_name %></h1>
<p class="text-mute text-sm mt-1"><%= @user.email %> <%= "· #{@user.phone}" if @user.phone.present? %> · joined <%= l @user.created_at, format: :long %></p>

<div class="mt-8 grid gap-6 md:grid-cols-2">
  <section class="card p-5">
    <h2 class="font-extrabold">Step One · <%= @pathway.lessons_done %>/<%= @pathway.lessons_total %></h2>
    <ul class="mt-3 space-y-1 text-sm">
      <% @pathway.lesson_items.each do |i| %><li class="flex justify-between"><span><%= i.record.title %></span><%= status_pill(i.status) %></li><% end %>
    </ul>
  </section>
  <section class="card p-5">
    <h2 class="font-extrabold">Step Two · <%= @pathway.assessments_done %>/<%= @pathway.assessments.size %></h2>
    <ul class="mt-3 space-y-1 text-sm">
      <% @pathway.assessment_items.each do |i| %><li class="flex justify-between"><span><%= i.record.title %></span><%= status_pill(i.status) %></li><% end %>
    </ul>
    <h2 class="font-extrabold mt-5">Step Three</h2>
    <p class="text-sm text-mute mt-1">
      <% if @user.appointment %><%= @user.appointment.status.humanize %><%= " · #{l @user.appointment.scheduled_at, format: :long}" if @user.appointment.scheduled_at %><%= " · #{@user.appointment.meeting_preference}" if @user.appointment.meeting_preference %>
      <% else %>Locked<% end %>
    </p>
  </section>
</div>

<% if @results.any? %>
  <h2 class="text-lg font-extrabold mt-10">Assessment results</h2>
  <div class="mt-3 grid gap-4 md:grid-cols-3">
    <% @results.each do |r| %>
      <section class="card p-5">
        <h3 class="font-bold"><%= r.assessment.title %></h3>
        <ul class="mt-3 space-y-2 text-sm">
          <% r.assessment.ranked(r).each do |cat, score| %>
            <li><div class="flex justify-between"><span><%= cat %></span><span class="text-mute"><%= score %>%</span></div><div class="bar mt-1"><span style="width:<%= score %>%"></span></div></li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
<% end %>
