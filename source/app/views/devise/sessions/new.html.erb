<% page_title "Sign in" %>
<div class="mx-auto max-w-md px-5">
  <h1 class="h-page">Welcome back</h1>
  <p class="text-center text-mute mt-2">Sign in to pick up where you left off.</p>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "card mt-8 p-6 md:p-8 space-y-5" }) do |f| %>
    <div><%= f.label :email, class: "label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field" %></div>
    <div><%= f.label :password, class: "label" %><%= f.password_field :password, autocomplete: "current-password", class: "field" %></div>
    <div class="flex items-center justify-between text-sm">
      <label class="flex items-center gap-2 text-mute"><%= f.check_box :remember_me, class: "rounded border-line bg-panel" %> Remember me</label>
      <%= link_to "Forgot password?", new_password_path(resource_name), class: "btn-link" %>
    </div>
    <%= f.submit "Sign in", class: "btn-go w-full" %>
    <p class="text-center text-sm text-mute">New here? <%= link_to "Create your account", new_registration_path(resource_name) %></p>
  <% end %>
</div>
