# ---- Copy to .env (development) or set as host env vars (production) ----

# Postgres (development uses config/database.yml defaults; production uses DATABASE_URL)
# DATABASE_URL=postgres://user:pass@host:5432/all_in_production

# Rails
# SECRET_KEY_BASE=   # production only: `bin/rails secret`
RAILS_MAX_THREADS=5
APP_HOST=allin.encounterny.com
CHURCH_NAME=Encounter Church
CHURCH_EMAIL=Connect@EncounterNY.com

# Step 3 scheduling handoff (Calendly / Church Center Calendar / any booking link)
SCHEDULING_URL=https://calendly.com/YOUR-TEAM/all-in-appointment
# Optional: link to the next monthly All In gathering registration (Church Center Registrations)
ALL_IN_GATHERING_URL=https://ecny.churchcenter.com/registrations

# Transactional email (password resets). Any SMTP provider: Resend, Postmark, SendGrid, Google Workspace.
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
MAIL_FROM=All In <allin@encounterny.com>

# Cloudflare R2 for Active Storage (thumbnails) in production
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=all-in-media

# Optional: Planning Center handoff (creates/updates a Person + adds a Workflow card when someone finishes)
PCO_APP_ID=
PCO_SECRET=
PCO_WORKFLOW_ID=
