<% page_title "My Progress" %>
<div class="wrap">
  <h1 class="h-page">My Progress</h1>
  <div class="mx-auto mt-4 max-w-xs">
    <div class="bar" role="progressbar" aria-valuenow="<%= pathway.percent %>" aria-valuemin="0" aria-valuemax="100"><span style="width:<%= pathway.percent %>%"></span></div>
    <p class="text-center text-xs text-mute mt-2"><%= pathway.percent %>% of the way in</p>
  </div>

  <%# ---- Step One ---- %>
  <section class="card mt-10 p-6 md:p-8">
    <p class="kicker">STEP ONE</p>
    <h2 class="h-step mt-1"><%= pathway.learn_step.title %></h2>
    <p class="lead mt-2"><%= pathway.learn_step.description %></p>
    <div class="rail mt-6">
      <% pathway.lesson_items.each do |item| %>
        <% l = item.record %>
        <div class="rail-row">
          <span class="node <%= { complete: "node-done", current: "node-go" }[item.status] %>">
            <% if item.status == :complete %><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg><% end %>
          </span>
          <%= render "shared/lesson_thumb", lesson: l, size: "" %>
          <div class="flex-1 min-w-0">
            <h3 class="font-bold leading-snug"><%= (item.status == :locked && !current_user.admin?) ? l.title : link_to(l.title, lesson_path(l), class: "text-ink hover:text-glow") %></h3>
            <p class="text-sm text-mute mt-1"><%= l.description %></p>
          </div>
          <div class="shrink-0 pt-1">
            <% if item.status == :current %>
              <%= link_to "Continue", lesson_path(l), class: "pill pill-go" %>
            <% else %>
              <%= status_pill(item.status) %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <%# ---- Step Two ---- %>
  <section class="card mt-6 p-6 md:p-8">
    <p class="kicker">STEP TWO</p>
    <h2 class="h-step mt-1"><%= pathway.assess_step.title %></h2>
    <p class="lead mt-2"><%= pathway.assess_step.description %></p>
    <div class="rail mt-6">
      <% pathway.assessment_items.each do |item| %>
        <% a = item.record %>
        <div class="rail-row">
          <span class="node <%= { complete: "node-done", current: "node-go" }[item.status] %>">
            <% if item.status == :complete %><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg><% end %>
          </span>
          <div class="flex-1 min-w-0">
            <h3 class="font-bold"><%= (item.status == :locked && !current_user.admin?) ? a.title : link_to(a.title, (item.status == :complete ? results_assessment_path(a) : assessment_path(a)), class: "text-ink hover:text-glow") %></h3>
            <p class="text-sm text-mute mt-1"><%= a.question_count %> questions</p>
          </div>
          <div class="shrink-0 pt-1">
            <% if item.status == :current %>
              <%= link_to "Begin", assessment_path(a), class: "pill pill-go" %>
            <% elsif item.status == :complete %>
              <%= link_to "Show my results", results_assessment_path(a), class: "pill pill-done underline" %>
            <% else %>
              <%= status_pill(:locked) %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
      <%# ---- 4th row: the combined picture across all three assessments ---- %>
      <% full = pathway.assess_complete? %>
      <div class="rail-row">
        <span class="node <%= full ? "node-done" : "" %>">
          <% if full %><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg><% end %>
        </span>
        <div class="flex-1 min-w-0">
          <h3 class="font-bold"><%= full ? link_to("Your full design", my_plan_path, class: "text-ink hover:text-glow") : "Your full design" %></h3>
          <p class="text-sm text-mute mt-1">All three assessments combined into one picture: strengths, serve fits, and where you want to grow.</p>
        </div>
        <div class="shrink-0 pt-1">
          <% if full %><%= link_to "See full design", my_plan_path, class: "pill pill-go" %><% else %><%= status_pill(:locked) %><% end %>
        </div>
      </div>
  </section>

  <%# ---- Step Three ---- %>
  <section class="card mt-6 p-6 md:p-8">
    <p class="kicker">STEP THREE</p>
    <h2 class="h-step mt-1"><%= pathway.meet_step.title %></h2>
    <p class="lead mt-2"><%= pathway.meet_step.description %></p>
    <div class="mt-6 flex items-center justify-between gap-4">
      <p class="text-sm text-mute">
        <% if pathway.complete? %>You've RSVP'd. We'll see you at the gathering.
        <% elsif pathway.meet_unlocked? %>Everything is unlocked. RSVP for the next Sunday gathering.
        <% else %>You can RSVP for the gathering after you have completed all of the other steps.<% end %>
      </p>
      <% if pathway.complete? %>
        <%= link_to "Details", appointment_path, class: "pill pill-done underline" %>
      <% elsif pathway.meet_unlocked? %>
        <%= link_to "RSVP", appointment_path, class: "pill pill-go" %>
      <% else %>
        <%= status_pill(:locked) %>
      <% end %>
    </div>
  </section>
</div>
