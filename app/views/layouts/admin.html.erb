<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= page_title("Admin") %></title>
    <%= csrf_meta_tags %>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-full flex flex-col">
    <header class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 h-14 flex items-center gap-6 text-sm font-semibold">
        <%= link_to admin_root_path, class: "flex items-center gap-2 font-extrabold text-ink" do %><%= image_tag "ec-logo-ring.png", alt: "", class: "h-8 w-8" %> All In · Admin<% end %>
        <%= link_to "People", admin_users_path, class: "btn-link" %>
        <%= link_to "Insights", admin_insights_path, class: "btn-link" %>
        <%= link_to "Lessons", admin_lessons_path, class: "btn-link" %>
        <%= link_to "Assessments", admin_assessments_path, class: "btn-link" %>
        <%= link_to "RSVPs", admin_appointments_path, class: "btn-link" %>
        <span class="flex-1"></span>
        <%= link_to "Back to app", root_path, class: "btn-link" %>
      </div>
    </header>
    <% if notice %><div class="flash-notice"><%= notice %></div><% end %>
    <% if alert  %><div class="flash-alert"><%= alert %></div><% end %>
    <main class="flex-1 py-8"><div class="mx-auto max-w-6xl px-5"><%= yield %></div></main>
  </body>
</html>
