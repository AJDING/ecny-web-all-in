<% page_title "#{@assessment.title} results" %>
<div class="wrap">
  <p class="kicker text-center">STEP TWO</p>
  <h1 class="h-step text-center mt-1"><%= @assessment.title %></h1>
  <p class="lead text-center mt-2">Your top <%= @assessment.top_n %> — these become part of your profile</p>

  <div class="mt-8 space-y-4">
    <% @ranked.first(@assessment.top_n).each_with_index do |(cat, score), i| %>
      <% info = @assessment.category_info(cat) %>
      <section class="card p-6">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-xl font-extrabold"><%= i + 1 %>. <%= cat %></h2>
          <span class="text-sm font-bold text-glow"><%= score %>%</span>
        </div>
        <div class="bar mt-3"><span style="width:<%= score %>%"></span></div>
        <p class="text-ink/90 mt-4 leading-relaxed"><%= info[:summary] %></p>
        <% if info[:serve].present? %>
          <p class="text-sm text-mute mt-3">Where this fits at <%= settings[:church_name] %>: <%= Array(info[:serve]).join(", ") %>.</p>
        <% end %>
      </section>
    <% end %>
  </div>

  <%# ---- Learn more: the categories outside the top N, lowest first ---- %>
  <% rest = @ranked.drop(@assessment.top_n) %>
  <% if rest.any? %>
    <%= form_with url: interests_assessment_path(@assessment), method: :post, class: "card mt-6 p-6" do |f| %>
      <h2 class="text-lg font-extrabold">Want to grow in any of these?</h2>
      <p class="text-mute text-sm mt-1">A lower score isn't a weakness — it's often just unexplored. Tick anything you'd like to learn more about and we'll bring it to your All In gathering and shape future classes around it.</p>
      <ul class="mt-5 space-y-3">
        <% rest.each do |cat, score| %>
          <li class="flex items-start gap-3">
            <input type="checkbox" name="categories[]" value="<%= cat %>" id="gi-<%= cat.parameterize %>"
                   <%= "checked" if current_user.growth_interest?(@assessment, cat) %>
                   class="mt-1 h-4 w-4 rounded border-line bg-panel text-royal focus:ring-royal">
            <label for="gi-<%= cat.parameterize %>" class="flex-1 cursor-pointer">
              <span class="flex justify-between text-sm"><span class="font-semibold"><%= cat %></span><span class="text-mute"><%= score %>%</span></span>
              <span class="block text-xs text-mute mt-0.5"><%= @assessment.category_info(cat)[:summary].to_s.truncate(110) %></span>
            </label>
          </li>
        <% end %>
      </ul>
      <div class="mt-6 flex items-center justify-between">
        <%= link_to "Retake", assessment_path(@assessment), class: "btn-link" %>
        <%= f.submit "Save to my profile", class: "btn-go" %>
      </div>
    <% end %>
  <% end %>

  <p class="mt-8 text-center"><%= link_to "Back to My Progress", my_progress_path, class: "btn-ghost" %></p>
</div>
