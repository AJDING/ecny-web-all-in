<% page_title "#{@assessment.title} results" %>
<div class="wrap">
  <p class="kicker text-center">STEP TWO</p>
  <h1 class="h-step text-center mt-1"><%= @assessment.title %></h1>
  <p class="lead text-center mt-2">Your top <%= @assessment.top_n %></p>

  <div class="mt-8 space-y-4">
    <% @ranked.first(@assessment.top_n).each_with_index do |(cat, score), i| %>
      <% info = @assessment.category_info(cat) %>
      <section class="card p-6">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-xl font-extrabold"><%= i + 1 %>. <%= cat %></h2>
          <span class="text-sm font-bold text-glow"><%= score %>%</span>
        </div>
        <div class="bar mt-3"><span style="width:<%= score %>%"></span></div>
        <p class="text-ink/90 mt-4 leading-relaxed"><%= info[:summary] %></p>
        <% if info[:serve].present? %>
          <p class="text-sm text-mute mt-3">Where this fits at <%= settings[:church_name] %>: <%= Array(info[:serve]).join(", ") %>.</p>
        <% end %>
      </section>
    <% end %>
  </div>

  <details class="card mt-6 p-6">
    <summary class="cursor-pointer font-semibold">All scores</summary>
    <ul class="mt-4 space-y-3">
      <% @ranked.each do |cat, score| %>
        <li><div class="flex justify-between text-sm"><span><%= cat %></span><span class="text-mute"><%= score %>%</span></div><div class="bar mt-1"><span style="width:<%= score %>%"></span></div></li>
      <% end %>
    </ul>
  </details>

  <div class="mt-8 flex items-center justify-between">
    <%= link_to "Retake", assessment_path(@assessment), class: "btn-link" %>
    <%= link_to "Back to My Progress", my_progress_path, class: "btn-go" %>
  </div>
</div>
