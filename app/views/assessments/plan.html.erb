<% page_title "My Profile" %>
<div class="wrap">
  <h1 class="h-page">My Profile</h1>
  <p class="text-center text-mute mt-2"><%= current_user.full_name %> &middot; how you're designed, and where you want to grow</p>

  <% strengths = current_user.strengths; growth = current_user.growth_areas %>
  <% if strengths.empty? %>
    <div class="card mt-8 p-8 text-center">
      <p class="font-bold">Your profile builds itself as you go</p>
      <p class="text-mute mt-1">Finish the three assessments in Step Two and your strengths, serve-team fits, and growth areas appear here.</p>
      <p class="mt-5"><%= link_to "Go to My Progress", my_progress_path, class: "btn-go" %></p>
    </div>
  <% else %>
    <%# ---- Summary strip ---- %>
    <section class="card mt-8 p-6">
      <h2 class="text-lg font-extrabold">At a glance</h2>
      <div class="mt-4 grid gap-6 md:grid-cols-2">
        <div>
          <p class="text-sm font-semibold text-mute">Strengths</p>
          <div class="mt-2 flex flex-wrap gap-2">
            <% strengths.each do |a, top| top.each do |cat, _| %>
              <span class="rounded-md bg-royal/20 border border-royal/40 px-2.5 py-1 text-sm text-glow"><%= cat %></span>
            <% end end %>
          </div>
        </div>
        <div>
          <p class="text-sm font-semibold text-mute">Wants to learn more about</p>
          <div class="mt-2 flex flex-wrap gap-2">
            <% if growth.empty? %><span class="text-sm text-mute">Nothing yet — tick a few on any results page.</span><% end %>
            <% growth.each do |a, cats| cats.each do |cat| %>
              <span class="rounded-md bg-panel border border-line px-2.5 py-1 text-sm"><%= cat %></span>
            <% end end %>
          </div>
        </div>
      </div>
    </section>

    <%# ---- Per assessment ---- %>
    <% strengths.each do |a, top| %>
      <section class="card mt-6 p-6 md:p-8">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-xl font-extrabold"><%= a.title %></h2>
          <%= link_to "Full results", results_assessment_path(a), class: "btn-link" %>
        </div>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          <% top.each do |cat, score| %>
            <% info = a.category_info(cat) %>
            <div class="rounded-xl border border-line bg-panel/60 p-4">
              <div class="flex justify-between text-sm"><span class="font-bold"><%= cat %></span><span class="text-glow"><%= score %>%</span></div>
              <p class="text-xs text-mute mt-2 leading-relaxed"><%= info[:summary].to_s.truncate(160) %></p>
              <% if info[:serve].present? %><p class="text-xs text-glow/80 mt-2"><%= Array(info[:serve]).first(2).join(" · ") %></p><% end %>
            </div>
          <% end %>
        </div>
        <% cats = growth.find { |ga, _| ga.id == a.id }&.last %>
        <% if cats.present? %>
          <p class="mt-4 text-sm text-mute">Wants to grow in: <span class="text-ink"><%= cats.join(", ") %></span></p>
        <% end %>
      </section>
    <% end %>

    <p class="mt-8 text-center text-sm text-mute">Bring this with you — the team will see it at your All In gathering.</p>
    <p class="mt-3 text-center"><%= link_to "Back to My Progress", my_progress_path, class: "btn-ghost" %></p>
  <% end %>
</div>
