<% page_title "Resend confirmation" %>
<div class="mx-auto max-w-md px-5">
  <h1 class="h-page">Resend confirmation</h1>
  <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "card mt-8 p-6 md:p-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div><%= f.label :email, class: "label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field" %></div>
    <%= f.submit "Resend confirmation link", class: "btn-go w-full" %>
  <% end %>
</div>
