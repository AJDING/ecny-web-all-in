<% page_title "Reset password" %>
<div class="mx-auto max-w-md px-5">
  <h1 class="h-page">Reset your password</h1>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "card mt-8 p-6 md:p-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div><%= f.label :email, class: "label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field" %></div>
    <%= f.submit "Send me reset instructions", class: "btn-go w-full" %>
    <p class="text-center text-sm"><%= link_to "Back to sign in", new_session_path(resource_name), class: "btn-link" %></p>
  <% end %>
</div>
