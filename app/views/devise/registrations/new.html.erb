<% page_title "Create account" %>
<div class="mx-auto max-w-md px-5">
  <h1 class="h-page">Let's go all in</h1>
  <p class="text-center text-mute mt-2">Create your profile to start Step One. Each person gets their own account.</p>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "card mt-8 p-6 md:p-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="grid grid-cols-2 gap-4">
      <div><%= f.label :first_name, class: "label" %><%= f.text_field :first_name, autofocus: true, autocomplete: "given-name", class: "field" %></div>
      <div><%= f.label :last_name, class: "label" %><%= f.text_field :last_name, autocomplete: "family-name", class: "field" %></div>
    </div>
    <div><%= f.label :email, class: "label" %><%= f.email_field :email, autocomplete: "email", class: "field" %></div>
    <%= render "devise/shared/phone_fields", f: f %>
    <div><%= f.label :password, class: "label" %><%= f.password_field :password, autocomplete: "new-password", class: "field" %><p class="text-xs text-mute mt-1">At least <%= @minimum_password_length %> characters.</p></div>
    <div><%= f.label :password_confirmation, "Confirm password", class: "label" %><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field" %></div>
    <%= f.submit "Create my account", class: "btn-go w-full" %>
    <p class="text-center text-sm text-mute">Already have an account? <%= link_to "Sign in", new_session_path(resource_name) %></p>
  <% end %>
</div>
