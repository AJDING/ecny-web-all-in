<% page_title "Account" %>
<div class="mx-auto max-w-md px-5">
  <h1 class="h-page">Account</h1>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "card mt-8 p-6 md:p-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="grid grid-cols-2 gap-4">
      <div><%= f.label :first_name, class: "label" %><%= f.text_field :first_name, class: "field" %></div>
      <div><%= f.label :last_name, class: "label" %><%= f.text_field :last_name, class: "field" %></div>
    </div>
    <div>
      <%= f.label :email, class: "label" %><%= f.email_field :email, class: "field" %>
      <% if resource.pending_reconfirmation? %>
        <p class="text-xs text-glow mt-1">Pending: <%= resource.unconfirmed_email %> — check that inbox for the confirmation link. Your current email stays active until then.</p>
      <% else %>
        <p class="text-xs text-mute mt-1">Changing your email sends a confirmation link to the new address; enter your current password below to change it.</p>
      <% end %>
    </div>
    <div><%= f.label :phone, "Mobile phone", class: "label" %><%= f.telephone_field :phone, class: "field" %></div>
    <hr class="border-line">
    <p class="text-sm text-mute">Leave the password fields blank unless you want to change it.</p>
    <div><%= f.label :password, "New password", class: "label" %><%= f.password_field :password, autocomplete: "new-password", class: "field" %></div>
    <div><%= f.label :password_confirmation, "Confirm new password", class: "label" %><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field" %></div>
    <div><%= f.label :current_password, "Current password (required to change email or password)", class: "label" %><%= f.password_field :current_password, autocomplete: "current-password", class: "field" %></div>
    <%= f.submit "Save changes", class: "btn-go w-full" %>
  <% end %>
  <p class="mt-6 text-center text-xs text-mute">To delete your account, email <%= mail_to settings[:church_email] %>.</p>
</div>
