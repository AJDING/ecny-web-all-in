<% page_title "All In Sunday Gathering" %>
<div class="wrap">
  <p class="kicker text-center">STEP THREE</p>
  <h1 class="h-step text-center mt-1"><%= pathway.meet_step.title %></h1>
  <p class="lead text-center mt-3 max-w-[60ch] mx-auto"><%= pathway.meet_step.description %></p>

  <div class="card mt-8 p-6 md:p-8">
    <% if @appointment.scheduled? %>
      <h2 class="text-xl font-extrabold">You're on the list</h2>
      <p class="text-mute mt-2">
        <% if @appointment.scheduled_at %>You RSVP'd for the gathering on <%= l @appointment.scheduled_at, format: :long %>.<% else %>Your RSVP is in. We'll see you at the next All In Sunday Gathering.<% end %>
      </p>
      <p class="mt-4 text-sm text-mute">Come ready to meet the team, connect, ask questions, and receive prayer. Need to change your RSVP? <%= mail_to settings[:church_email], "Email the All In team" %>.</p>
      <p class="mt-6"><%= link_to "Open my profile", my_plan_path, class: "btn-go" %></p>
    <% else %>
      <h2 class="text-xl font-extrabold">RSVP for the next gathering</h2>
      <ol class="mt-4 space-y-3 text-ink/90 list-decimal pl-5">
        <li>Open the RSVP page and pick the next Sunday gathering (they happen once a month).</li>
        <li>Come back here and confirm, so the team can prepare your profile and pray for you by name.</li>
      </ol>
      <% if settings[:all_in_gathering_url].present? %>
        <p class="mt-6"><%= link_to "Open RSVP page", settings[:all_in_gathering_url], class: "btn-go", target: "_blank", rel: "noopener" %></p>
      <% else %>
        <p class="mt-6 text-sm text-red-300">RSVP link not configured yet. Set ALL_IN_GATHERING_URL (see README).</p>
      <% end %>

      <%= form_with url: appointment_path, method: :post, class: "mt-8 border-t border-line pt-6 space-y-4" do |f| %>
        <div>
          <%= f.label :scheduled_at, "Which gathering did you RSVP for? (optional)", class: "label" %>
          <%= f.date_field :scheduled_at, class: "field" %>
        </div>
        <div>
          <%= f.label :meeting_preference, "Who's coming with you? (optional)", class: "label" %>
          <%= f.select :meeting_preference, ["Just me", "My spouse and me", "My family", "A friend and me"], { include_blank: "Choose one" }, class: "field" %>
        </div>
        <%= f.submit "I've RSVP'd", class: "btn-go" %>
      <% end %>

      <% if settings[:scheduling_url].present? %>
        <p class="mt-6 text-sm text-mute">Can't make a Sunday gathering? <%= link_to "Book a one-on-one with the team instead", settings[:scheduling_url], target: "_blank", rel: "noopener" %>.</p>
      <% end %>
    <% end %>
  </div>
</div>
