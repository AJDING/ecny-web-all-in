<h1 class="text-2xl font-extrabold">Site settings</h1>
<p class="text-mute text-sm mt-1">Choices here apply to the whole site immediately — every page, for every person.</p>

<%= form_with url: admin_settings_path, method: :patch, class: "card mt-6 p-6 max-w-xl space-y-5" do |f| %>
  <div>
    <%= f.label "settings[font]", "Text font", class: "label" %>
    <%= f.select "settings[font]", SiteSetting::FONTS.map { |key, opt| [opt[:label], key] }, { selected: @font }, class: "field" %>
    <p class="text-xs text-mute mt-2">Preview of each option:</p>
    <ul class="mt-2 space-y-2">
      <% SiteSetting::FONTS.each do |key, opt| %>
        <li class="rounded-lg border px-4 py-3 <%= key == @font ? 'border-royal bg-royalink/20' : 'border-line bg-panel/50' %>"
            style="font-family: <%= opt[:family] %>; font-size: <%= opt[:size] %>; line-height: <%= opt[:line_height] %>;">
          <span class="text-xs text-mute block" style="font-family: Manrope, sans-serif;"><%= opt[:label] %><%= " · current" if key == @font %></span>
          One encounter with Jesus will change your life forever. We never want church to feel like a place where you come in on a Sunday and leave.
        </li>
      <% end %>
    </ul>
  </div>
  <%= f.submit "Save", class: "btn-go" %>
<% end %>
