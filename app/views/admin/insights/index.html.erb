<h1 class="text-2xl font-extrabold">Insights</h1>
<p class="text-mute text-sm mt-1">Aggregate results for everyone who has registered. Each report below shows the average per category across all completed assessments, the capacity pie, and who scores highest in each category.</p>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% [["Registered", @people_total], ["Finished Step One", @step_one_done], ["Finished all assessments", @all_three_done], ["RSVP'd / attended", @rsvps]].each do |label, n| %>
    <div class="card p-5"><p class="text-sm text-mute"><%= label %></p><p class="text-3xl font-extrabold mt-1"><%= n %></p></div>
  <% end %>
</div>

<h2 class="text-lg font-extrabold mt-10">Reports</h2>
<div class="mt-3 grid gap-4 md:grid-cols-2">
  <% @assessments.each do |a| %>
    <%= link_to admin_insight_path(a.slug), class: "card p-5 hover:border-royal transition-colors block" do %>
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="font-extrabold text-ink"><%= a.title %></h3>
        <span class="text-sm text-mute"><%= @completed_by[a.id].to_i %> completed</span>
      </div>
      <p class="text-sm text-mute mt-1"><%= a.categories.size %> categories · averages, capacity pie, top people per category</p>
    <% end %>
  <% end %>
  <%= link_to admin_insight_path("full-design"), class: "card p-5 hover:border-royal transition-colors block border-royal/40" do %>
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="font-extrabold text-ink">Full design (everyone)</h3>
      <span class="text-sm text-mute"><%= @all_three_done %> finished all three</span>
    </div>
    <p class="text-sm text-mute mt-1">All categories from all assessments on one scale — the church-wide picture</p>
  <% end %>
</div>
